{
	"name": "companion-module-grassvalley-kayenne",
	"version": "2026.0.9-beta.3",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "npm run build && companion-module-build --prerelease",
		"build": "rimraf dist && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"test": "npm run build && node test/test-builders.cjs && node test/test-legacy-actions.mjs && node test/test-upgrades.mjs && node test/test-config.mjs && node --test test/repro-connection-lifecycle.cjs test/repro-keyer-tally.mjs test/repro-keyer-active-tally.mjs test/repro-multi-action-feedback.mjs test/repro-macro-dropdown.mjs test/repro-review-2026-0-9-2.mjs test/repro-command-safety.cjs test/repro-protocol-round3.cjs test/repro-module-round3.mjs",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "npm run lint:raw -- ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-grassvalley-kayenne.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"npm run lint:raw -- --fix"
		]
	},
	"packageManager": "yarn@4.17.0"
}
